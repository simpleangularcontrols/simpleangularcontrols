{
    "name": "sac-controls",
    "version": "0.0.0",
    "license": "MIT",
    "scripts": {
        "ng": "ng",
        "start": "ng serve",
        "build": "ng build",
        "test": "ng test",
        "lint": "ng lint",
        "e2e": "ng e2e",
        "demo-bs3": "ng serve demo-bootstrap3 --port 4200",
        "demo-bs4": "ng serve demo-bootstrap4 --port 4201",
        "demo-bs5": "ng serve demo-bootstrap5 --port 4202",
        "build-common": "ng build --project sac-common",
        "build-bs3": "ng build --project sac-bootstrap3",
        "build-bs4": "ng build --project sac-bootstrap4",
        "build-bs5": "ng build --project sac-bootstrap5",
        "run-common": "ng build --project sac-common --watch",
        "run-bs3": "ng build --project sac-bootstrap3 --watch",
        "run-bs4": "ng build --project sac-bootstrap4 --watch",
        "run-bs5": "ng build --project sac-bootstrap5 --watch",
        "lint-common": "ng lint sac-common",
        "lint-bs3": "ng lint sac-bootstrap3",
        "lint-bs4": "ng lint sac-bootstrap4",
        "lint-bs5": "ng lint sac-bootstrap5",
        "compodoc-bs3": "node compodoc.prepare.js && npx compodoc -c bootstrap3.compodocrc.json",
        "compodoc-bs4": "node compodoc.prepare.js && npx compodoc -c bootstrap4.compodocrc.json",
        "compodoc-bs5": "node compodoc.prepare.js && npx compodoc -c bootstrap5.compodocrc.json",
        "doc-bs3": "start http://localhost:8888 & npx compodoc -r 8888 -s -d ../docs/bootstrap3",
        "doc-bs4": "start http://localhost:8888 & npx compodoc -r 8888 -s -d ../docs/bootstrap4",
        "doc-bs5": "start http://localhost:8888 & npx compodoc -r 8888 -s -d ../docs/bootstrap5",
        "test-edit-bs3": "npx cypress open -C projects/sac-bootstrap3/cypress.config.ts --env coverage=true",
        "test-edit-bs4": "npx cypress open -C projects/sac-bootstrap4/cypress.config.ts --env coverage=true",
        "test-edit-bs5": "npx cypress open -C projects/sac-bootstrap5/cypress.config.ts --env coverage=true",
        "test-bs3": "npm run build-common && npm run instrument-common && npx cypress run --component -C projects/sac-bootstrap3/cypress.config.ts --env coverage=true",
        "test-bs4": "npm run build-common && npm run instrument-common && npx cypress run --component -C projects/sac-bootstrap4/cypress.config.ts --env coverage=true",
        "test-bs5": "npm run build-common && npm run instrument-common && npx cypress run --component -C projects/sac-bootstrap5/cypress.config.ts --env coverage=true",
        "ngcc": "ngcc",
        "cypress:open": "cypress open",
        "cypress:run": "cypress run",
        "instrument-common": "npx nyc instrument ./dist/sac-common --in-place",
        "format": "npm install --prefix tools/tsco && node tools/tsco/node_modules/tsco-cli/out/src/index.js -o -c ./tsco.json -s ./projects && node tools/tsco/node_modules/tsco-cli/out/src/index.js -o -c ./tsco.json -s ./src && npx prettier --write projects/**/*.{ts,html,scss} && npx prettier --write src/**/*.{ts,html,scss}"
    },
    "private": true,
    "dependencies": {
        "@angular/animations": "^17.0.0",
        "@angular/common": "^17.0.0",
        "@angular/compiler": "^17.0.0",
        "@angular/core": "^17.0.0",
        "@angular/forms": "^17.0.0",
        "@angular/localize": "^17.0.0",
        "@angular/platform-browser": "^17.0.0",
        "@angular/platform-browser-dynamic": "^17.0.0",
        "@angular/router": "^17.0.0",
        "@tinymce/tinymce-angular": "9.1.1",
        "angular-imask": "7.6.1",
        "core-js": "3.6.5",
        "imask": "7.6.1",
        "moment": "2.30.1",
        "ngx-toastr": "16.2.0",
        "ngx-uploadx": "6.2.1",
        "rxjs": "~7.8.0",
        "tinymce": "^8.6.0",
        "tslib": "^2.3.0",
        "zone.js": "~0.14.10"
    },
    "devDependencies": {
        "@angular-devkit/build-angular": "^17.0.0",
        "@angular-devkit/core": "^17.0.0",
        "@angular-eslint/builder": "^17.0.0",
        "@angular-eslint/eslint-plugin": "^17.0.0",
        "@angular-eslint/eslint-plugin-template": "^17.0.0",
        "@angular-eslint/schematics": "^17.0.0",
        "@angular-eslint/template-parser": "^17.0.0",
        "@angular/cli": "^17.0.0",
        "@angular/compiler-cli": "^17.0.0",
        "@angular/language-service": "^17.0.0",
        "@compodoc/compodoc": "1.1.32",
        "@cypress/code-coverage": "3.14.7",
        "@cypress/schematic": "2.5.2",
        "@types/node": "^14.0.5",
        "@typescript-eslint/eslint-plugin": "5.62.0",
        "@typescript-eslint/parser": "5.62.0",
        "cypress": "13.17.0",
        "cypress-file-upload": "^5.0.8",
        "eslint": "^8.51.0",
        "mochawesome": "^7.1.3",
        "mochawesome-json-to-md": "2.0.0",
        "mochawesome-merge": "5.1.0",
        "ng-packagr": "^17.0.0",
        "prettier": "3.8.1",
        "tsco-cli": "2.0.15",
        "typescript": "~5.2.2"
    }
}
