{
    "extends": "../../.eslintrc.json",
    "ignorePatterns": ["!**/*"],
    "overrides": [
        {
            "files": ["*.ts"],

            "parserOptions": {
                "project": ["projects/sac-common/tsconfig.lib.json", "projects/sac-common/tsconfig.spec.json"],
                "createDefaultProgram": true
            },
            "plugins": ["@typescript-eslint"],
            "rules": {
                "@angular-eslint/directive-selector": [
                    "error",
                    {
                        "type": "attribute",
                        "prefix": "sac",
                        "style": "camelCase"
                    }
                ],
                "@angular-eslint/component-selector": [
                    "error",
                    {
                        "type": "element",
                        "prefix": "sac",
                        "style": "kebab-case"
                    }
                ],
                "@typescript-eslint/no-inferrable-types": [
                    "error",
                    {
                        "ignoreParameters": false,
                        "ignoreProperties": false
                    }
                ]
            }
        },
        {
            "files": ["*.html"],
            "rules": {}
        }
    ]
}
